# ===== 应用配置 =====
SECRET_KEY=your-secret-key-change-this-to-a-random-string
FLASK_ENV=production
PORT=5000

# ===== 文本模型配置 =====
# 可选: deepseek | openai | dashscope | mock
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ===== 视觉模型配置（OCR用，可选）=====
# 可选: ark | deepseek | mock
LLM_VISION_PROVIDER=ark
LLM_VISION_API_KEY=your-vision-api-key
LLM_VISION_MODEL=doubao-vision-pro-32k

# ===== 数据库 =====
DATABASE_URL=sqlite:///zhijing.db

# ===== 上传配置 =====
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=uploads
